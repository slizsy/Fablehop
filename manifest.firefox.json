{
  "manifest_version": 3,
  "name": "Fablehop Unrepost",
  "version": "1.1.0",
  "description": "Clears your TikTok reposts, likes and favorites, one by one, while you watch the counter go up.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fablehop Unrepost",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "logo.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "unrepost@fablehop",
      "strict_min_version": "127.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "toggle-run": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Start or stop clearing on the current TikTok tab"
    }
  }
}
